# Copy this file to .env.local. Web and worker both load it; restart both after edits.
# Each capability has independent credentials, model and base URL.

# Text: openai (OpenAI-compatible chat completions), anthropic, or deepseek
TEXT_PROVIDER=openai
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_MODEL=gpt-4o

# Image: fal or OpenAI-compatible Images API.
# IMAGE_PROVIDER=fal  # or openai; full /images/generations URLs auto-select openai.
# For openai, BASE_URL may be the API root or full /images/generations endpoint,
# and IMAGE_MODEL is sent in the body; use a dedicated IMAGE_API_KEY.
# For fal, IMAGE_MODEL is an endpoint path, not a full URL.
IMAGE_BASE_URL=https://queue.fal.run
IMAGE_API_KEY=
IMAGE_MODEL=fal-ai/flux/schnell

# Video: fal-compatible queue API with Seedance-compatible request fields.
# MODEL: seedance-2-0 / seedance-1-0-lite / seedance-1-0-pro,
# or a custom endpoint path such as vendor/model/image-to-video.
# An explicit VIDEO_MODEL overrides the canvas node's model selection.
VIDEO_BASE_URL=https://queue.fal.run
VIDEO_API_KEY=
VIDEO_MODEL=seedance-2-0

# Audio: OpenAI-compatible /audio/speech API; separate from text.
AUDIO_BASE_URL=https://api.openai.com/v1
AUDIO_API_KEY=
AUDIO_MODEL=tts-1

# Legacy fallbacks (optional): scoped *_API_KEY settings take precedence.
# Text: OPENAI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY, MODEL_NAME.
# Without TEXT_* settings, text priority is Anthropic > OpenAI > DeepSeek.
# Image and video: FAL_API_KEY. Audio: OPENAI_API_KEY.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# FAL_API_KEY=
# MODEL_NAME=

# `npm run dev` starts both the web server and generation worker; Ctrl+C stops both.
# For `npm run start`, run `npm run worker` separately for background generation.
# Scoped worker: npm run worker -- --project PROJECT_ID
# One scoped operation: npm run worker -- --project PROJECT_ID --once
# Default mode uses real providers; missing keys fail visibly.
# STORYREEL_GENERATION_MODE=mock  # Explicit local demo/test mode only

# SQLite storage (requires Node.js >= 22.13).
# .storyreel/storyreel.sqlite  projects, publications, production state, asset metadata and worker heartbeat
# .storyreel/media/            uploaded and generated media files
# Browser localStorage is an editing cache; the server database is authoritative.
# The first database open imports legacy projects/publications/production/assets JSON files
# in one transaction. Original JSON files are retained but no longer used for writes.
# Run `npm run db:migrate` to initialize/import and check database integrity.
# Stop the web server and worker together before switching from JSON storage.
# For a consistent offline backup, stop both processes and copy the whole data directory.
# STORYREEL_DATA_DIR=/absolute/path/to/storyreel-data

# Next.js
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Single-workspace editor access. Required in production; use HTTPS when exposed remotely.
# Viewers can still open published /player/:id links without editor credentials.
# STORYREEL_EDITOR_USER=editor
# STORYREEL_EDITOR_PASSWORD=use-a-long-random-password

# Optional: override the actual text model context window (tokens); 16000–2000000.
# TEXT_CONTEXT_WINDOW=128000

# Optional complete image-edit endpoint (otherwise inferred as /images/edits).
# The Zode QA edit endpoint uses X-Api-Key and multipart image uploads.
# IMAGE_EDIT_BASE_URL=https://your-image-service/v1/images/edits
# IMAGE_EDIT_MODEL=gpt-image-2.5-flare
